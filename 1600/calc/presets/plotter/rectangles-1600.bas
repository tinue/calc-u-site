10 REM RECTANGLES: one per pen, large to small
20 CLEAR :WAIT 0
30 LCURSOR 0:COLOR 0:CSIZE 2
40 LPRINT "Rectangles"
50 GRAPH :GLCURSOR (0,-60):SORGN
60 FOR C=0TO 3
70 O=C*20:S=200-C*40
80 COLOR C:GLCURSOR (O,-O)
90 LLINE -(O+S,-O)-(O+S,-O-S)-(O,-O-S)-(O,-O)
100 PRINT "Pen";C
110 NEXT C
120 GLCURSOR (0,-240)
130 TEXT :PRINT "Complete"
140 WAIT :END
